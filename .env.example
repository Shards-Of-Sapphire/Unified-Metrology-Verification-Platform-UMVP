# UMVP Configuration Environment Variables
PORT=3000
NODE_ENV=development

# GEMINI_API_KEY: Optional - Required for Gemini AI metrology assistant & OCR
GEMINI_API_KEY=

# APP_URL / Base URL for verification links & QR codes
APP_URL=http://localhost:3000

# =========================================================================
# POSTGRESQL DATABASE CONFIGURATION (RECOMMENDED FOR TEAM PROJECTS)
# =========================================================================
# Option 1 (Recommended for Teams): Cloud PostgreSQL connection string (Neon / Supabase / Render)
# e.g., DATABASE_URL="postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
# e.g., DATABASE_URL="postgresql://postgres:yourpassword@db.xxxxxx.supabase.co:5432/postgres"
DATABASE_URL=

# Option 2: Local PostgreSQL discrete variables
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=your_password
# SQL_DB_NAME=umvp_db
# SQL_SSL=false
